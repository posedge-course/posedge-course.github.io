e-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" CLOSED;","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"endcase","color":"var(--code-token-keyword)","bold":true}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"// The state register.","color":"var(--code-token-comment)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (rst) state ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" CLOSED;","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":"     state ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" next;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"// Outputs from the state alone.","color":"var(--code-token-comment)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" is_open   ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" (state ","color":"var(--code-foreground)","bold":false},{"text":"==","color":"var(--code-token-keyword)","bold":false},{"text":" OPEN);","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" is_locked ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" (state ","color":"var(--code-foreground)","bold":false},{"text":"==","color":"var(--code-token-keyword)","bold":false},{"text":" LOCKED);","color":"var(--code-foreground)","bold":false}],[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]],"bugLine":18,"fixLine":"next = state;"},{"id":"ns-fill-next","itemId":"next-state-logic","role":"core","promptHtml":"In lesson 5.2's two-block door, type what the state register does at a rising edge where <code class=\"nobreak\">rst</code> is 0.","explanationHtml":"<p>The register takes <code class=\"nobreak\">next</code>, which the next-state logic has worked out from <code class=\"nobreak\">state</code> and the inputs. It decides nothing itself (lesson 5.2), so every transition lives in the <code class=\"nobreak\">always_comb</code> block, and this line never changes when states are added.</p>","type":"fill","file":"hdl/level-05/door2/door2.sv","firstLine":1,"totalLines":36,"before":["// The door of lesson 5.1, in the two-block form. push opens a closed door","// and closes an open one; key locks a closed door and unlocks a locked","// one. push and key are one-cycle pulses; push wins if both come at once.","module door2 (","  input  logic clk,","  input  logic rst,        // at a rising edge: the door is closed","  input  logic push,","  input  logic key,","  output logic is_open,","  output logic is_locked",");","  typedef enum logic [1:0] {CLOSED, OPEN, LOCKED} state_t;","  state_t state, next;","","  // Next-state logic: the state the door goes to at the next rising edge.","  always_comb begin","    next = state;                 // unless a line below says otherwise","    case (state)","      CLOSED: if (push)     next = OPEN;","              else if (key) next = LOCKED;","      OPEN:   if (push)     next = CLOSED;","      LOCKED: if (key)      next = CLOSED;","      default:              next = CLOSED;","    endcase","  end","","  // The state register.","  always_ff @(posedge clk) begin","    if (rst) state <= CLOSED;"],"blankLine":{"left":"    else     ","right":";"},"after":["  end","","  // Outputs from the state alone.","  assign is_open   = (state == OPEN);","  assign is_locked = (state == LOCKED);","endmodule"],"highlighted":{"before":[[{"text":"// The door of lesson 5.1, in the two-block form. push opens a closed door","color":"var(--code-token-comment)","bold":false}],[{"text":"// and closes an open one; key locks a closed door and unlocks a locked","color":"var(--code-token-comment)","bold":false}],[{"text":"// one. push and key are one-cycle pulses; push wins if both come at once.","color":"var(--code-token-comment)","bold":false}],[{"text":"module","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"door2","color":"var(--code-token-function)","bold":false},{"text":" (","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"input","color":"var(--code-token-constant)","bold":true},{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"logic","color":"var(--code-token-keyword)","bold":true},{"text":" clk,","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":f