,"bold":false},{"text":" OPEN;","color":"var(--code-foreground)","bold":false}]],"blankLine":{"left":[{"text":"                ","color":"var(--code-foreground)","bold":false}],"right":[{"text":" state ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" LOCKED;","color":"var(--code-foreground)","bold":false}]},"after":[]},"accept":["else if (key)","else if (key & ~push)","else if (~push & key)"],"caseSensitive":true,"blankLabel":"The start of the line"}]