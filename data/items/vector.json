oreground)","bold":false},{"text":"logic","color":"var(--code-token-keyword)","bold":true},{"text":"       carry","color":"var(--code-foreground)","bold":false}],[{"text":");","color":"var(--code-foreground)","bold":false}],[{"text":"  logic","color":"var(--code-token-keyword)","bold":true},{"text":" [","color":"var(--code-foreground)","bold":false},{"text":"3","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"] sum;           ","color":"var(--code-foreground)","bold":false},{"text":"// the sum of a and b","color":"var(--code-token-comment)","bold":false}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" sum   ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" a ","color":"var(--code-foreground)","bold":false},{"text":"+","color":"var(--code-token-keyword)","bold":false},{"text":" b;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" low   ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" sum[","color":"var(--code-foreground)","bold":false},{"text":"3","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"];","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" carry ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" sum[","color":"var(--code-fore