n-keyword)","bold":true},{"text":" (valid) acc ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" base ","color":"var(--code-foreground)","bold":false},{"text":"+","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"20","color":"var(--code-token-constant)","bold":false},{"text":"'","color":"var(--code-token-keyword)","bold":false},{"text":"(prod);","color":"var(--code-foreground)","bold":false}],[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]],"bugLine":12,"fixLine":"input  logic signed [3:0]  w,"},{"id":"w4-fill-sact","itemId":"four-bit-weights","role":"core","promptHtml":"In lesson 12.1's <code class=\"nobreak\">mac4</code>, <code class=\"nobreak\">act</code> is an unsigned activation, 0 to 255, and <code class=\"nobreak\">w</code> a signed weight. Fill in <code class=\"nobreak\">sact</code>, nine bits, so that <code>sact * w</code> is worked out signed and <code class=\"nobreak\">sact</code> keeps the value of <code class=\"nobreak\">act</code>.","explanationHtml":"<p><code>$signed({1'b0, act})</code>, or just <code>{1'b0, act}</code>. The 0 on top keeps the value: 1000 0000, 128, becomes 0 1000 0000, still 128. <code class=\"nobreak\">sact</code> is declared <code class=\"nobreak\">signed</code>, so <code>sact * w</code> is worked out signed; <code class=\"nobreak\">$signed</code> only says so again. <code class=\"nobreak\">$signed(act)</code> alone would turn 128 to 255 into negative numbers, and <code class=\"nobreak\">act</code> used straight in the product would make the whole product unsigned.</p>","type":"fill","file":"hdl/level-12/mac4/mac4.sv","firstLine":17,"totalLines":28,"before":["  logic signed [8:0]  sact;              // act, as a signed number","  logic signed [12:0] prod;              // act * w: -2040 to 1785","  logic signed [19:0] base;              // the bias, or the sum so far",""],"blankLine":{"left":"  assign sact = ","right":";"},"after":["  assign prod = sact * w;","  assign base = first ? 20'(bias) : acc;","  assign pos  = (acc > 0);"],"highlighted":{"before":[[{"text":"  logic signed","color":"var(--code-token-keyword)","bold":true},{"text":" [","color":"var(--code-foreground)","bold":false},{"text":"8","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"]  sact;              ","color":"var(--code-foreground)","bold":false},{"text":"// act, as a signed number","color":"var(--code-token-comment)","bold":false}],[{"text":"  logic signed","color":"var(--code-token-keyword)","bold":true},{"text":" [","color":"var(--code-foreground)","bold":false},{"text":"12","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"] prod;              ","color":"var(--code-foreground)","bold":false},{"text":"// act * w: -2040 to 1785","color":"var(--code-token-comment)","bold":false}],[{"text":"  logic signed","color":"var(--code-token-keyword)","bold":true},{"text":" [","color":"var(--code-foreground)","bold":false},{"text":"19","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"] base;              ","color":"var(--code-foreground)","bold":false},{"text":"// the bias, or the sum so far","color":"var(--code-token-comment)","bold":false}],[]],"blankLine":{"left":[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" sact ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false}],"right":[{"text":";","color":"var(--code-foreground)","bold":false}]},"after":[[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" prod ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" sact ","color":"var(--code-foreground)","bold":false},{"text":"*","color":"var(--code-token-keyword)","bold":false},{"text":" w;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" base ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" first ","color":"var(--code-foreground)","bold":false},{"text":"?","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"20","color":"var(--code-token-constant)","bold":false},{"text":"'","color":"var(--code-token-keyword)","bold":false},{"text":"(bias) ","color":"var(--code-foreground)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":" acc;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" pos  ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" (acc ","color":"var(--code-foreground)","bold":false},{"text":">","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":");","color":"var(--code-foreground)","bold":false}]]},"accept":["$signed({1'b0, act})","$signed({1'd0, act})","$signed({1'b0, act[7:0]})","$signed({1'd0, act[7:0]})","{1'b0, act}","{1'd0, act}","{1'b0, act[7:0]}","{1'd0, act[7:0]}","9'(act)","$signed(9'(act))"],"caseSensitive":true,"blankLabel":"act as a signed number"},{"id":"w4-choice-layers","itemId":"four-bit-weights","role":"core","promptHtml":"The 3D decoder keeps 8-bit weights in its first and last layers and 4-bit weights in its two middle layers. Why those two?","explanationHtml":"<p>The two middle layers hold 442,368 weights each, 91% of the 971,568, so halving them saves the most bits: the weights then fit in 86% of the block RAM. And with only layer two cut to 4 bits, the decisions stayed close to those of the network with full-width weights, where cutting the small last layer spoiled them. A narrower weight is not a faster one: the engines work out the same products either way. And the hidden activations stay 8 bits.</p>","type":"choice","options":["They hold most of the weights, and cutting them to 4 bits changed the decisions least.","Four-bit weights let the engines work out each sum in fewer cycles.","Their activations are 4 bits wide, so their weights are too.","The first and last layers hold most of the weights, so they need all 8 bits."],"correct":0},{"id":"w4-report-dsp","itemId":"four-bit-weights","role":"core","promptHtml":"Lesson 12.1's <code class=\"nobreak\">mac4</code> multiplies a 9-bit signed activation by a 4-bit weight and adds the product to a 20-bit sum, one product a cycle. Below is the DSP table of its Utilization report.","explanationHtml":"<p>Read the DSPs row: 0. Vivado built the small product and the sum from LUTs and carry chains, as it did for level 6's <code class=\"nobreak\">mul8</code>. In the decoder's first board build, the hidden engines built their 4-bit by 8-bit products mostly from logic in the same way, and the whole decoder used only three DSP blocks.</p>","type":"report","source":"vivado/reports/mac4/arty-a7-100t/utilization.rpt","firstLine":112,"excerpt":["+-----------+------+-------+------------+-----------+-------+","| Site Type | Used | Fixed | Prohibited | Available | Util% |","+-----------+------+-------+------------+-----------+-------+","| DSPs      |    0 |     0 |          0 |       240 |  0.00 |","+-----------+------+-------+------------+-----------+-------+"],"ask":"How many DSP blocks does mac4 use?","answer":"0","numeric":true}]