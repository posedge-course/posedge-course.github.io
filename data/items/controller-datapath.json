ndmodule","color":"var(--code-token-keyword)","bold":true}]],"bugLine":38,"fixLine":"if (start & (state != BUSY)) begin"},{"id":"ctl-fill-add","itemId":"controller-datapath","role":"core","promptHtml":"In lesson 5.4's multiplier, the datapath should add <code class=\"nobreak\">addend</code> and count <code class=\"nobreak\">left</code> down only at edges where the controller is in <code class=\"nobreak\">BUSY</code> and additions are left. Type the condition after <code>else if</code>.","explanationHtml":"<p>The datapath acts only while the controller is in <code class=\"nobreak\">BUSY</code>, and only while <code class=\"nobreak\">left</code> is not 0. In the last busy cycle <code class=\"nobreak\">left</code> is 0, so nothing is added while the controller moves to <code class=\"nobreak\">DONE</code> (lesson 5.4). In <code class=\"nobreak\">IDLE</code> and <code class=\"nobreak\">DONE</code> the datapath holds its values, so <code class=\"nobreak\">product</code> stays readable.</p>","type":"fill","file":"hdl/level-05/mul_repeat/mul_repeat.sv","firstLine":36,"totalLines":50,"before":["  // The datapath: product and left, told what to do by the state.","  always_ff @(posedge clk) begin","    if (start & (state != BUSY)) begin","      product <= 12'd0;           // a new job starts from nothing","      addend  <= a;","      left    <= b;"],"blankLine":{"left":"    end else if (","right":") begin"},"after":["      product <= product + {4'd0, addend};","      left    <= left - 4'd1;","    end","  end"],"highlighted":{"before":[[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"// The datapath: product and left, told what to do by the state.","color":"var(--code-token-comment)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (start ","color":"var(--code-foreground)","bold":false},{"text":"&","color":"var(--code-token-keyword)","bold":false},{"text":" (state ","color":"var(--code-foreground)","bold":false},{"text":"!=","color":"var(--code-token-keyword)","bold":false},{"text":" BUSY)) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"      product ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"12'd0","color":"var(--code-token-constant)","bold":false},{"text":";           ","color":"var(--code-foreground)","bold":false},{"text":"// a new job starts from nothing","color":"var(--code-token-comment)","bold":false}],[{"text":"      addend  ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" a;","color":"var(--code-foreground)","bold":false}],[{"text":"      left    ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" b;","color":"var(--code-foreground)","bold":false}]],"blankLine":{"left":[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (","color":"var(--code-foreground)","bold":false}],"right":[{"text":") ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}]},"after":[[{"text":"      product ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" product ","color":"var(--code-foreground)","bold":false},{"text":"+","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"{","color":"var(--code-token-keyword)","bold":false},{"text":"4'd0","color":"var(--code-token-constant)","bold":false},{"text":", addend","color":"var(--code-foreground)","bold":false},{"text":"}","color":"var(--code-token-keyword)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"      left    ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" left ","color":"var(--code-foreground)","bold":false},{"text":"-","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"4'd1","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}]]},"accept":["(state == BUSY) & (left != 4'd0)","(left != 4'd0) & (state == BUSY)","busy & (left != 4'd0)","(left != 4'd0) & busy"],"caseSensitive":true,"blankLabel":"The condition"},{"id":"ctl-predict-zero","itemId":"controller-datapath","role":"core","promptHtml":"Lesson 5.4's multiplier, done with its last job at the start of the window. A job starts with <code class=\"nobreak\">b</code> at 0: no additions to do. Set <code class=\"nobreak\">busy</code> for every cycle.","explanationHtml":"<p>Even with nothing to add, the controller goes to <code class=\"nobreak\">BUSY</code> at the edge that takes <code class=\"nobreak\">start</code>, cycle 2, with <code class=\"nobreak\">left</code> at 0. In that cycle it sees <code class=\"nobreak\">left</code> at 0, so at the next edge it goes to <code class=\"nobreak\">DONE</code>: <code class=\"nobreak\">busy</code> is 1 for one cycle. <code class=\"nobreak\">product</code> stays 0, which is anything times 0.</p>","type":"waveform","wave":{"id":"mul-zero","source":"hdl/level-05/mul_repeat/mul_repeat_tb.sv","timescale":"1ps","period":10000,"periodText":"10 ns","unit":"cycle","cycles":6,"signals":[{"label":"clk","path":"mul_repeat_tb.clk","width":1,"role":"clock","changes":[[0,"1"],[0.5,"0"],[1,"1"],[1.5,"0"],[2,"1"],[2.5,"0"],[3,"1"],[3.5,"0"],[4,"1"],[4.5,"0"],[5,"1"],[5.5,"0"]]},{"label":"start","path":"mul_repeat_tb.start","width":1,"role":"signal","changes":[[0,"0"],[1.5,"1"],[2.5,"0"],[5.5,"1"]]},{"label":"b[3:0]","path":"mul_repeat_tb.b","width":4,"role":"signal","changes":[[0,"1111"],[1.5,"0000"],[5.5,"0001"]]},{"label":"busy","path":"mul_repeat_tb.busy","width":1,"role":"signal","changes":[[0,"0"],[2,"1"],[3,"0"]],"samples":["0","0","1","0","0","0"]}]},"answer":"busy"},{"id":"ctl-predict-again","itemId":"controller-datapath","role":"core","promptHtml":"Lesson 5.4's multiplier, done with its last job at the start of the window. <code class=\"nobreak\">b</code> is 1 for every job: one addition each. <code class=\"nobreak\">start</code> comes three times. Set <code class=\"nobreak\">done</code> for every cycle.","explanationHtml":"<p>The controller's <code class=\"nobreak\">case</code> sends <code class=\"nobreak\">DONE</code> to <code class=\"nobreak\">BUSY</code> on <code class=\"nobreak\">start</code>, as it does <code class=\"nobreak\">IDLE</code>, so <code class=\"nobreak\">done</code> falls at cycle 1. One addition keeps the controller busy for two cycles, 1 and 2 (lesson 5.4). The <code class=\"nobreak\">start</code> at cycle 3 is taken at an edge where the state is still <code class=\"nobreak\">BUSY</code>, so it is ignored: a transition depends on the state before the edge (lesson 5.1), and the controller goes to <code class=\"nobreak\">DONE</code>, 1 in cycles 3 and 4. The <code class=\"nobreak\">start</code> at cycle 5 comes in <code class=\"nobreak\">DONE</code>, so a job runs in cycles 5 and 6, and <code class=\"nobreak\">done</code> is 1 from cycle 7.</p>","type":"waveform","wave":{"id":"mul-again","source":"hdl/level-05/mul_repeat/mul_repeat_tb.sv","timescale":"1ps","period":10000,"periodText":"10 ns","unit":"cycle","cycles":10,"signals":[{"label":"clk","path":"mul_repeat_tb.clk","width":1,"role":"clock","changes":[[0,"1"],[0.5,"0"],[1,"1"],[1.5,"0"],[2,"1"],[2.5,"0"],[3,"1"],[3.5,"0"],[4,"1"],[4.5,"0"],[5,"1"],[5.5,"0"],[6,"1"],[6.5,"0"],[7,"1"],[7.5,"0"],[8,"1"],[8.5,"0"],[9,"1"],[9.5,"0"]]},{"label":"start","path":"mul_repeat_tb.start","width":1,"role":"signal","changes":[[0,"0"],[0.5,"1"],[1.5,"0"],[2.5,"1"],[3.5,"0"],[4.5,"1"],[5.5,"0"]]},{"label":"b[3:0]","path":"mul_repeat_tb.b","width":4,"role":"signal","changes":[[0,"0000"],[0.5,"0001"]]},{"label":"done","path":"mul_repeat_tb.done","width":1,"role":"signal","changes":[[0,"1"],[1,"0"],[3,"1"],[5,"0"],[7,"1"]],"samples":["1","0","0","1","1","0","0","1","1","1"]}]},"answer":"done"}]