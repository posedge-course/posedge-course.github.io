code-token-keyword)","bold":false},{"text":" want) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"      ","color":"var(--code-foreground)","bold":false},{"text":"$display","color":"var(--code-token-function)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"\"TEST FAILED: ","color":"var(--code-token-string-expression)","bold":false},{"text":"%b%b%b","color":"var(--code-token-constant)","bold":false},{"text":" gave siren=","color":"var(--code-token-string-expression)","bold":false},{"text":"%b","color":"var(--code-token-constant)","bold":false},{"text":", expected ","color":"var(--code-token-string-expression)","bold":false},{"text":"%b","color":"var(--code-token-constant)","bold":false},{"text":" at ","color":"var(--code-token-string-expression)","bold":false},{"text":"%0d","color":"var(--code-token-constant)","bold":false},{"text":" ns\"","color":"var(--code-token-string-expression)","bold":false},{"text":",","color":"var(--code-foreground)","bold":false}],[{"text":"               armed, door_open, window_open, siren, want, ","color":"var(--code-foreground)","bold":false},{"text":"$time","color":"var(--code-token-function)","bold":false},{"text":");","color":"var(--code-foreground)","bold":false}],[{"text":"      errors ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" errors ","color":"var(--code-foreground)","bold":false},{"text":"+","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"1","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"endtask","color":"var(--code-token-keyword)","bold":true}]]},"accept":["#10","#10ns","#(10)","#(10ns)"],"caseSensitive":true,"blankLabel":"The missing wait"},{"id":"tools-choice-next","itemId":"toolchain","role":"core","promptHtml":"You changed one line of <code class=\"nobreak\">vote.sv</code>. Verilator prints no warnings, and you have no board. How do you find out whether <code class=\"nobreak\">y</code> is still right for every row?","explanationHtml":"<p>Only a run of the testbench compares <code class=\"nobreak\">y</code> with the expected value of every row. Verilator looks for likely mistakes, such as a signal nobody uses; a wrong <code class=\"nobreak\">&amp;</code> or <code class=\"nobreak\">|</code> is legal code, so it stays quiet. A build that finishes means the code became hardware, right or wrong. And the old <code class=\"nobreak\">vote_tb.vcd</code> shows the old design: each run writes the file again.</p>","type":"choice","options":["Compile and run `vote_tb.sv` with Icarus Verilog, and read its verdict.","Nothing more: no warnings from Verilator means `y` is right.","Build it with Vivado: if the build finishes, `y` is right.","Open the `vote_tb.vcd` you made before the change."],"correct":0}]