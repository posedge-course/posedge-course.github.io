reground)","bold":false}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" tick ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" (count ","color":"var(--code-foreground)","bold":false},{"text":"==","color":"var(--code-token-keyword)","bold":false},{"text":" LAST);","color":"var(--code-foreground)","bold":false}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (rst)       count ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"'0","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (tick) count ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"'0","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":"           count ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" count ","color":"var(--code-foreground)","bold":false},{"text":"+","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"1","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]],"bugLine":6,"fixLine":"LAST = 4"},{"id":"cnt-find-bug-narrow","itemId":"counter","role":"core","promptHtml":"This counter should make <code class=\"nobreak\">tick</code> 1 for one cycle in every ten. Verilator warns WIDTHTRUNC on the <code class=\"nobreak\">LAST</code> line: the value 9 needs more bits than <code class=\"nobreak\">LAST</code> has. Pick the line that is wrong.","explanationHtml":"<p>One tick in every ten needs <code class=\"nobreak\">LAST</code> at 9, as the <code class=\"nobreak\">LAST</code> line says, and 9 is 1001 in binary: four bits. But <code class=\"nobreak\">count</code> and <code class=\"nobreak\">LAST</code> are both <code class=\"nobreak\">BITS</code> wide, and three bits hold only 0 to 7, so <code class=\"nobreak\">count</code> could never reach 9, and <code class=\"nobreak\">LAST</code> itself is cut to three bits. Verilator points at the <code class=\"nobreak\">LAST</code> line because that is where 9 is cut, but its value is right. The width on the <code class=\"nobreak\">BITS</code> line is too small.</p>","type":"find-bug","file":"hdl/level-04/tick_gen_narrow_bug/tick_gen_narrow_bug.sv","firstLine":1,"lines":[[{"text":"// tick should be 1 for one cycle in every ten. count goes 0, 1, 2 and so","color":"var(--code-token-comment)","bold":false}],[{"text":"// on up to LAST, then back to 0; tick is 1 during the cycle when count is","color":"var(--code-token-comment)","bold":false}],[{"text":"// LAST.","color":"var(--code-token-comment)","bold":false}],[{"text":"module","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"tick_gen_narrow_bug","color":"var(--code-token-function)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"#","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"parameter","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"int","color":"var(--code-token-keyword)","bold":true},{"text":"              BITS ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"3","color":"var(--code-token-constant)","bold":false},{"text":",","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"parameter","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"logic","color":"var(--code-token-keyword)","bold":true},{"text":" [BITS","color":"var(--code-foreground)","bold":false},{"text":"-","color":"var(--code-token-keyword)","bold":false},{"text":"1","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"] LAST ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":