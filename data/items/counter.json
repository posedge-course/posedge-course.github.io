-foreground)","bold":false}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (rst)       count ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"'0","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (tick) count ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"'0","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":"           count ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" count ","color":"var(--code-foreground)","bold":false},{"text":"+","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"1","color":"var(--code-token-constant)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]],"bugLine":5,"fixLine":"BITS = 4"},{"id":"cnt-fill-bits","itemId":"counter","role":"core","promptHtml":"<code class=\"nobreak\">tick_led</code> uses lesson 4.1's <code class=\"nobreak\">tick_gen</code> to change an LED once a second on the Arty's 100 MHz clock, so <code class=\"nobreak\">LAST</code> is 99,999,999 (written <code class=\"nobreak\">99_999_999</code>: an underscore only groups digits). <code class=\"nobreak\">BITS</code> sets the width of <code class=\"nobreak\">count</code>. Type the fewest bits that can hold <code class=\"nobreak\">LAST</code>.","explanationHtml":"<p>Each bit doubles what a vector can hold (lesson 1.1). 20 bits hold up to 1,048,575, about a million, so 26 bits hold up to 67,108,863 and 27 bits up to 134,217,727. 99,999,999 is more than 26 bits can hold and less than 27 can, so <code class=\"nobreak\">count</code> needs 27. With 26, <code class=\"nobreak\">LAST</code> would be cut to fit, and the count would end early.</p>","type":"fill","file":"hdl/level-04/tick_led/tick_led.sv","firstLine":5,"totalLines":23,"before":["module tick_led #("],"blankLine":{"left":"  parameter int              BITS = ","right":","},"after":["  parameter logic [BITS-1:0] LAST = 99_999_999",") ("],"highlighted":{"before":[[{"text":"module","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"tick_led","color":"var(--code-token-function)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"#","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false}]],"blankLine":{"left":[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"parameter","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"int","color":"var(--code-token-keyword)","bold":true},{"text":"              BITS ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false}],"right":[{"text":",","color":"var(--code-foreground)","bold":false}]},"after":[[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"parameter","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"logic","color":"var(--code-token-keyword)","bold":true},{"text":" [BITS","color":"var(--code-foreground)","bold":false},{"text":"-","color":"var(--code-token-keyword)","bold":false},{"text":"1","color":"var(--code-token-constant)","bold":false},{"text":":","color":"var(--code-token-keyword)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"] LAST ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"99_999_999","color":"var(--code-token-constant)","bold":false}],[{"text":") (","color":"var(--code-foreground)","bold":false}]]},"accept":["27"],"caseSensitive":true,"blankLabel":"The width of count"},{"id":"cnt-report-fdre","itemId":"counter","role":"core","promptHtml":"Vivado built <code class=\"nobreak\">tick_led</code> for the Arty A7-100T: lesson 4.1's <code class=\"nobreak\">tick_gen</code> with <code class=\"nobreak\">BITS</code> at 27, and one more flip-flop for an LED that changes at each tick. Below is the Primitives table of its Utilization report: one row for each kind of cell, with how many the design uses.","explanationHtml":"<p>A counter is a register, one flip-flop for each bit (lessons 2.4 and 4.1), so <code class=\"nobreak\">count</code> takes 27 FDREs, and <code class=\"nobreak\">led</code> one more. The CARRY4 and LUT rows are the counter's logic, which level 6 reads; BUFG is the clock, and IBUF and OBUF are the pins.</p>","type":"report","source":"vivado/reports/tick_led/arty-a7-100t/utilization.rpt","firstLine":180,"excerpt":["+----------+------+---------------------+","| Ref Name | Used | Functional Category |","+----------+------+---------------------+","| FDRE     |   28 |        Flop & Latch |","| CARRY4   |    7 |          CarryLogic |","| LUT6     |    4 |                 LUT |","| LUT3     |    2 |                 LUT |","| IBUF     |    2 |                  IO |","| OBUF     |    1 |                  IO |","| LUT5     |    1 |                 LUT |","| LUT2     |    1 |                 LUT |","| LUT1     |    1 |                 LUT |","| BUFG     |    1 |               Clock |","+----------+------+---------------------+"],"ask":"How many FDRE flip-flops did Vivado use for tick_led?","answer":"28","numeric":true}]