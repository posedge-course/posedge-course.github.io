lk)","color":"var(--code-foreground)","bold":false}],[{"text":"    hist ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"{","color":"var(--code-token-keyword)","bold":false},{"text":"hist[","color":"var(--code-foreground)","bold":false},{"text":"0","color":"var(--code-token-constant)","bold":false},{"text":"], level","color":"var(--code-foreground)","bold":false},{"text":"}","color":"var(--code-token-keyword)","bold":false},{"text":";","color":"var(--code-foreground)","bold":false}],[]],"blankLine":{"left":[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" rise ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false}],"right":[{"text":";","color":"var(--code-foreground)","bold":false}]},"after":[[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]]},"accept":["hist[0] & ~hist[1]","~hist[1] & hist[0]"],"caseSensitive":true,"blankLabel":"The right-hand side"}]