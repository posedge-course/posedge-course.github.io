lse},{"text":"else","color":"var(--code-token-keyword)","bold":true},{"text":"     q_rise ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" d;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk ","color":"var(--code-foreground)","bold":false},{"text":"or","color":"var(--code-token-keyword)","bold":false},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"negedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    q_both ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" d;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]],"bugLine":15,"fixLine":"always_ff @(posedge clk) begin"},{"id":"synth-fill-delay","itemId":"synthesisable-subset","role":"core","promptHtml":"Synthesis drops one part of this line, and only the simulator obeys it. Type that part.","explanationHtml":"<p><code class=\"nobreak\">#20</code> is a delay: wait 20 time units, which is 20 ns in this course's testbenches. The simulator obeys it; synthesis drops it, so the FPGA joins <code class=\"nobreak\">led</code> to <code class=\"nobreak\">btn</code> with a wire (lesson 3.4). Without it, the line is an ordinary <code class=\"nobreak\">assign</code>.</p>","type":"fill","file":"hdl/level-03/late_led/late_led.sv","firstLine":1,"totalLines":8,"before":["// Lights the LED 20 ns after the button changes, but only in simulation:","// synthesis drops the delay.","module late_led (","  input  logic btn,","  output logic led",");"],"blankLine":{"left":"  assign ","right":" led = btn;"},"after":["endmodule"],"highlighted":{"before":[[{"text":"// Lights the LED 20 ns after the button changes, but only in simulation:","color":"var(--code-token-comment)","bold":false}],[{"text":"// synthesis drops the delay.","color":"var(--code-token-comment)","bold":false}],[{"text":"module","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"late_led","color":"var(--code-token-function)","bold":false},{"text":" (","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"input","color":"var(--code-token-constant)","bold":true},{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"logic","color":"var(--code-token-keyword)","bold":true},{"text":" btn,","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"output","color":"var(--code-token-constant)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"logic","color":"var(--code-token-keyword)","bold":true},{"text":" led","color":"var(--code-foreground)","bold":false}],[{"text":");","color":"var(--code-foreground)","bold":false}]],"blankLine":{"left":[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"assign","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false}],"right":[{"text":" led ","color":"var(--code-foreground)","bold":false},{"text":"=","color":"var(--code-token-keyword)","bold":false},{"text":" btn;","color":"var(--code-foreground)","bold":false}]},"after":[[{"text":"endmodule","color":"var(--code-token-keyword)","bold":true}]]},"accept":["#20","# 20","#20ns","#(20)","#(20ns)"],"caseSensitive":true,"blankLabel":"The simulation-only part"},{"id":"synth-predict-again","itemId":"synthesisable-subset","role":"core","promptHtml":"This is a simulation of lesson 3.4's <code class=\"nobreak\">late_led</code>, whose <code class=\"nobreak\">assign</code> makes <code class=\"nobreak\">led</code> follow <code class=\"nobreak\">btn</code> 20 ns late. Each step is 10 ns, and <code class=\"nobreak\">btn</code> was 1 for the two steps before this window. Set <code class=\"nobreak\">led</code> for each step.","explanationHtml":"<p>In simulation the line delays <code class=\"nobreak\">btn</code> by 20 ns, two steps (lesson 3.4). In steps 0 and 1 <code class=\"nobreak\">led</code> shows the 1 that <code class=\"nobreak\">btn</code> held before the window, and in steps 2 and 3 the 1 it held in steps 0 and 1. Then <code class=\"nobreak\">led</code> falls in step 4, two steps after <code class=\"nobreak\">btn</code> falls in step 2, and rises in step 7, two steps after <code class=\"nobreak\">btn</code> rises in step 5. On the board the 20 ns would be gone: synthesis drops the delay, and <code class=\"nobreak\">led</code> follows <code class=\"nobreak\">btn</code> through two pin buffers and a wire.</p>","type":"waveform","wave":{"id":"late-led-again","source":"hdl/level-03/late_led/late_led_tb.sv","timescale":"1ps","period":10000,"periodText":"10 ns","unit":"step","cycles":8,"signals":[{"label":"btn","path":"late_led_tb.btn","width":1,"role":"signal","changes":[[0,"1"],[2,"0"],[5,"1"]]},{"label":"led","path":"late_led_tb.led","width":1,"role":"signal","changes":[[0,"1"],[4,"0"],[7,"1"]],"samples":["1","1","1","1","0","0","0","1"]}]},"answer":"led"}]