","color":"var(--code-token-comment)","bold":false}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    sync0 ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" btn;","color":"var(--code-foreground)","bold":false}],[{"text":"    sync  ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" sync0;","color":"var(--code-foreground)","bold":false}],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"end","color":"var(--code-token-keyword)","bold":true}],[],[{"text":"  ","color":"var(--code-foreground)","bold":false},{"text":"always_ff","color":"var(--code-token-keyword)","bold":true},{"text":" ","color":"var(--code-foreground)","bold":false},{"text":"@","color":"var(--code-token-keyword)","bold":false},{"text":"(","color":"var(--code-foreground)","bold":false},{"text":"posedge","color":"var(--code-token-keyword)","bold":true},{"text":" clk) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"    ","color":"var(--code-foreground)","bold":false},{"text":"if","color":"var(--code-token-keyword)","bold":true},{"text":" (rst) ","color":"var(--code-foreground)","bold":false},{"text":"begin","color":"var(--code-token-keyword)","bold":true}],[{"text":"      stable ","color":"var(--code-foreground)","bold":false},{"text":"<=","color":"var(--code-token-keyword)","bold":false},{"text":" ","colo