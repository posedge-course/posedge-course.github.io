## Pins for msum32 on the Arty A7, from Digilent's master XDC.
## clk is the board's 100 MHz oscillator.
set_property PACKAGE_PIN E3 [get_ports clk]
create_clock -name sys_clk_pin -period 10.00 [get_ports clk]
## din[0] to din[7] are JA pin 1 to JA pin 10.
set_property PACKAGE_PIN G13 [get_ports {din[0]}]
set_property PACKAGE_PIN B11 [get_ports {din[1]}]
set_property PACKAGE_PIN A11 [get_ports {din[2]}]
set_property PACKAGE_PIN D12 [get_ports {din[3]}]
set_property PACKAGE_PIN D13 [get_ports {din[4]}]
set_property PACKAGE_PIN B18 [get_ports {din[5]}]
set_property PACKAGE_PIN A18 [get_ports {din[6]}]
set_property PACKAGE_PIN K16 [get_ports {din[7]}]
## din[8] to din[15] are JB pin 1 to JB pin 10.
set_property PACKAGE_PIN E15 [get_ports {din[8]}]
set_property PACKAGE_PIN E16 [get_ports {din[9]}]
set_property PACKAGE_PIN D15 [get_ports {din[10]}]
set_property PACKAGE_PIN C15 [get_ports {din[11]}]
set_property PACKAGE_PIN J17 [get_ports {din[12]}]
set_property PACKAGE_PIN J18 [get_ports {din[13]}]
set_property PACKAGE_PIN K15 [get_ports {din[14]}]
set_property PACKAGE_PIN J15 [get_ports {din[15]}]
## y[0] to y[13] are ChipKit pins IO0 to IO13.
set_property PACKAGE_PIN V15 [get_ports {y[0]}]
set_property PACKAGE_PIN U16 [get_ports {y[1]}]
set_property PACKAGE_PIN P14 [get_ports {y[2]}]
set_property PACKAGE_PIN T11 [get_ports {y[3]}]
set_property PACKAGE_PIN R12 [get_ports {y[4]}]
set_property PACKAGE_PIN T14 [get_ports {y[5]}]
set_property PACKAGE_PIN T15 [get_ports {y[6]}]
set_property PACKAGE_PIN T16 [get_ports {y[7]}]
set_property PACKAGE_PIN N15 [get_ports {y[8]}]
set_property PACKAGE_PIN M16 [get_ports {y[9]}]
set_property PACKAGE_PIN V17 [get_ports {y[10]}]
set_property PACKAGE_PIN U18 [get_ports {y[11]}]
set_property PACKAGE_PIN R17 [get_ports {y[12]}]
set_property PACKAGE_PIN P17 [get_ports {y[13]}]
## y[14] to y[20] are ChipKit pins IO26 to IO32.
set_property PACKAGE_PIN U11 [get_ports {y[14]}]
set_property PACKAGE_PIN V16 [get_ports {y[15]}]
set_property PACKAGE_PIN M13 [get_ports {y[16]}]
set_property PACKAGE_PIN R10 [get_ports {y[17]}]
set_property PACKAGE_PIN R11 [get_ports {y[18]}]
set_property PACKAGE_PIN R13 [get_ports {y[19]}]
set_property PACKAGE_PIN R15 [get_ports {y[20]}]
## Every pin uses 3.3 V signals.
set_property IOSTANDARD LVCMOS33 [get_ports {clk din[*] y[*]}]
