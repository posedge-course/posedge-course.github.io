## Pins for bank4 on the Arty A7, from Digilent's master XDC.
## clk is the board's 100 MHz oscillator.
set_property PACKAGE_PIN E3 [get_ports clk]
create_clock -name sys_clk_pin -period 10.00 [get_ports clk]
## lane0[0] to lane0[7] are JA pin 1 to JA pin 10.
set_property PACKAGE_PIN G13 [get_ports {lane0[0]}]
set_property PACKAGE_PIN B11 [get_ports {lane0[1]}]
set_property PACKAGE_PIN A11 [get_ports {lane0[2]}]
set_property PACKAGE_PIN D12 [get_ports {lane0[3]}]
set_property PACKAGE_PIN D13 [get_ports {lane0[4]}]
set_property PACKAGE_PIN B18 [get_ports {lane0[5]}]
set_property PACKAGE_PIN A18 [get_ports {lane0[6]}]
set_property PACKAGE_PIN K16 [get_ports {lane0[7]}]
## lane1[0] to lane1[7] are JB pin 1 to JB pin 10.
set_property PACKAGE_PIN E15 [get_ports {lane1[0]}]
set_property PACKAGE_PIN E16 [get_ports {lane1[1]}]
set_property PACKAGE_PIN D15 [get_ports {lane1[2]}]
set_property PACKAGE_PIN C15 [get_ports {lane1[3]}]
set_property PACKAGE_PIN J17 [get_ports {lane1[4]}]
set_property PACKAGE_PIN J18 [get_ports {lane1[5]}]
set_property PACKAGE_PIN K15 [get_ports {lane1[6]}]
set_property PACKAGE_PIN J15 [get_ports {lane1[7]}]
## lane2[0] to lane2[7] are JC pin 1 to JC pin 10.
set_property PACKAGE_PIN U12 [get_ports {lane2[0]}]
set_property PACKAGE_PIN V12 [get_ports {lane2[1]}]
set_property PACKAGE_PIN V10 [get_ports {lane2[2]}]
set_property PACKAGE_PIN V11 [get_ports {lane2[3]}]
set_property PACKAGE_PIN U14 [get_ports {lane2[4]}]
set_property PACKAGE_PIN V14 [get_ports {lane2[5]}]
set_property PACKAGE_PIN T13 [get_ports {lane2[6]}]
set_property PACKAGE_PIN U13 [get_ports {lane2[7]}]
## lane3[0] to lane3[7] are JD pin 1 to JD pin 10.
set_property PACKAGE_PIN D4 [get_ports {lane3[0]}]
set_property PACKAGE_PIN D3 [get_ports {lane3[1]}]
set_property PACKAGE_PIN F4 [get_ports {lane3[2]}]
set_property PACKAGE_PIN F3 [get_ports {lane3[3]}]
set_property PACKAGE_PIN E2 [get_ports {lane3[4]}]
set_property PACKAGE_PIN D2 [get_ports {lane3[5]}]
set_property PACKAGE_PIN H2 [get_ports {lane3[6]}]
set_property PACKAGE_PIN G2 [get_ports {lane3[7]}]
## wdata[0] to wdata[7] are chipKIT pins IO0 to IO7.
set_property PACKAGE_PIN V15 [get_ports {wdata[0]}]
set_property PACKAGE_PIN U16 [get_ports {wdata[1]}]
set_property PACKAGE_PIN P14 [get_ports {wdata[2]}]
set_property PACKAGE_PIN T11 [get_ports {wdata[3]}]
set_property PACKAGE_PIN R12 [get_ports {wdata[4]}]
set_property PACKAGE_PIN T14 [get_ports {wdata[5]}]
set_property PACKAGE_PIN T15 [get_ports {wdata[6]}]
set_property PACKAGE_PIN T16 [get_ports {wdata[7]}]
## waddr[0] to waddr[5] are chipKIT pins IO8 to IO13, waddr[6] IO26.
set_property PACKAGE_PIN N15 [get_ports {waddr[0]}]
set_property PACKAGE_PIN M16 [get_ports {waddr[1]}]
set_property PACKAGE_PIN V17 [get_ports {waddr[2]}]
set_property PACKAGE_PIN U18 [get_ports {waddr[3]}]
set_property PACKAGE_PIN R17 [get_ports {waddr[4]}]
set_property PACKAGE_PIN P17 [get_ports {waddr[5]}]
set_property PACKAGE_PIN U11 [get_ports {waddr[6]}]
## base[0] to base[6] are chipKIT pins IO27 to IO33.
set_property PACKAGE_PIN V16 [get_ports {base[0]}]
set_property PACKAGE_PIN M13 [get_ports {base[1]}]
set_property PACKAGE_PIN R10 [get_ports {base[2]}]
set_property PACKAGE_PIN R11 [get_ports {base[3]}]
set_property PACKAGE_PIN R13 [get_ports {base[4]}]
set_property PACKAGE_PIN R15 [get_ports {base[5]}]
set_property PACKAGE_PIN P15 [get_ports {base[6]}]
## we is chipKIT pin IO34.
set_property PACKAGE_PIN R16 [get_ports we]
## Every pin uses 3.3 V signals.
set_property IOSTANDARD LVCMOS33 [get_ports {clk we waddr[*] wdata[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports {base[*] lane0[*] lane1[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports {lane2[*] lane3[*]}]
