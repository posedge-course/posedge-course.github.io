## Pins for mul_shift16 on the Arty A7, from Digilent's master XDC.
## clk is the board's 100 MHz oscillator.
set_property PACKAGE_PIN E3 [get_ports clk]
create_clock -name sys_clk_pin -period 10.00 [get_ports clk]
## rst is BTN0.
set_property PACKAGE_PIN D9 [get_ports rst]
## start is BTN1.
set_property PACKAGE_PIN C9 [get_ports start]
## busy is LD4.
set_property PACKAGE_PIN H5 [get_ports busy]
## done is LD5.
set_property PACKAGE_PIN J5 [get_ports done]
## a[0] to a[7] are JA pin 1 to JA pin 10.
set_property PACKAGE_PIN G13 [get_ports {a[0]}]
set_property PACKAGE_PIN B11 [get_ports {a[1]}]
set_property PACKAGE_PIN A11 [get_ports {a[2]}]
set_property PACKAGE_PIN D12 [get_ports {a[3]}]
set_property PACKAGE_PIN D13 [get_ports {a[4]}]
set_property PACKAGE_PIN B18 [get_ports {a[5]}]
set_property PACKAGE_PIN A18 [get_ports {a[6]}]
set_property PACKAGE_PIN K16 [get_ports {a[7]}]
## a[8] to a[15] are JB pin 1 to JB pin 10.
set_property PACKAGE_PIN E15 [get_ports {a[8]}]
set_property PACKAGE_PIN E16 [get_ports {a[9]}]
set_property PACKAGE_PIN D15 [get_ports {a[10]}]
set_property PACKAGE_PIN C15 [get_ports {a[11]}]
set_property PACKAGE_PIN J17 [get_ports {a[12]}]
set_property PACKAGE_PIN J18 [get_ports {a[13]}]
set_property PACKAGE_PIN K15 [get_ports {a[14]}]
set_property PACKAGE_PIN J15 [get_ports {a[15]}]
## b[0] to b[7] are JC pin 1 to JC pin 10.
set_property PACKAGE_PIN U12 [get_ports {b[0]}]
set_property PACKAGE_PIN V12 [get_ports {b[1]}]
set_property PACKAGE_PIN V10 [get_ports {b[2]}]
set_property PACKAGE_PIN V11 [get_ports {b[3]}]
set_property PACKAGE_PIN U14 [get_ports {b[4]}]
set_property PACKAGE_PIN V14 [get_ports {b[5]}]
set_property PACKAGE_PIN T13 [get_ports {b[6]}]
set_property PACKAGE_PIN U13 [get_ports {b[7]}]
## b[8] to b[15] are JD pin 1 to JD pin 10.
set_property PACKAGE_PIN D4 [get_ports {b[8]}]
set_property PACKAGE_PIN D3 [get_ports {b[9]}]
set_property PACKAGE_PIN F4 [get_ports {b[10]}]
set_property PACKAGE_PIN F3 [get_ports {b[11]}]
set_property PACKAGE_PIN E2 [get_ports {b[12]}]
set_property PACKAGE_PIN D2 [get_ports {b[13]}]
set_property PACKAGE_PIN H2 [get_ports {b[14]}]
set_property PACKAGE_PIN G2 [get_ports {b[15]}]
## p[0] to p[13] are ChipKit pins IO0 to IO13.
set_property PACKAGE_PIN V15 [get_ports {p[0]}]
set_property PACKAGE_PIN U16 [get_ports {p[1]}]
set_property PACKAGE_PIN P14 [get_ports {p[2]}]
set_property PACKAGE_PIN T11 [get_ports {p[3]}]
set_property PACKAGE_PIN R12 [get_ports {p[4]}]
set_property PACKAGE_PIN T14 [get_ports {p[5]}]
set_property PACKAGE_PIN T15 [get_ports {p[6]}]
set_property PACKAGE_PIN T16 [get_ports {p[7]}]
set_property PACKAGE_PIN N15 [get_ports {p[8]}]
set_property PACKAGE_PIN M16 [get_ports {p[9]}]
set_property PACKAGE_PIN V17 [get_ports {p[10]}]
set_property PACKAGE_PIN U18 [get_ports {p[11]}]
set_property PACKAGE_PIN R17 [get_ports {p[12]}]
set_property PACKAGE_PIN P17 [get_ports {p[13]}]
## p[14] to p[29] are ChipKit pins IO26 to IO41.
set_property PACKAGE_PIN U11 [get_ports {p[14]}]
set_property PACKAGE_PIN V16 [get_ports {p[15]}]
set_property PACKAGE_PIN M13 [get_ports {p[16]}]
set_property PACKAGE_PIN R10 [get_ports {p[17]}]
set_property PACKAGE_PIN R11 [get_ports {p[18]}]
set_property PACKAGE_PIN R13 [get_ports {p[19]}]
set_property PACKAGE_PIN R15 [get_ports {p[20]}]
set_property PACKAGE_PIN P15 [get_ports {p[21]}]
set_property PACKAGE_PIN R16 [get_ports {p[22]}]
set_property PACKAGE_PIN N16 [get_ports {p[23]}]
set_property PACKAGE_PIN N14 [get_ports {p[24]}]
set_property PACKAGE_PIN U17 [get_ports {p[25]}]
set_property PACKAGE_PIN T18 [get_ports {p[26]}]
set_property PACKAGE_PIN R18 [get_ports {p[27]}]
set_property PACKAGE_PIN P18 [get_ports {p[28]}]
set_property PACKAGE_PIN N17 [get_ports {p[29]}]
## p[30] to p[31] are ChipKit pins A0 to A1.
set_property PACKAGE_PIN F5 [get_ports {p[30]}]
set_property PACKAGE_PIN D8 [get_ports {p[31]}]
## Every pin uses 3.3 V signals.
set_property IOSTANDARD LVCMOS33 [get_ports {clk rst start busy done a[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports {b[*] p[*]}]
